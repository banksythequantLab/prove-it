# Vultr Serverless Inference (required for Challenge 1 LLM calls)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Confirm exact model IDs against the live model list at kickoff:
#   curl -H "Authorization: Bearer $VULTR_INFERENCE_API_KEY" $VULTR_INFERENCE_BASE_URL/models
FARADAY_TEXT_MODEL=
FARADAY_VISION_MODEL=

# Cage
FARADAY_CAGE_IMAGE=faraday-cage:latest
FARADAY_CAGE_NET=faraday-internal
FARADAY_CAGE_TIMEOUT_S=60
FARADAY_CAGE_MEMORY=512m
FARADAY_CAGE_CPUS=1.0
FARADAY_CAGE_PIDS=128

# Control plane
FARADAY_DB=/var/lib/faraday/faraday.db
FARADAY_CORPUS_DIR=/var/lib/faraday/corpus
FARADAY_APPROVAL_REQUIRED=true
